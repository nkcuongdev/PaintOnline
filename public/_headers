# Cloudflare Pages / Netlify headers (mục 10.2).
# vite.config.ts đọc dòng Content-Security-Policy ở đây để áp dụng cho `vite preview`,
# nhờ vậy E2E chạy với đúng CSP của bản deploy.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Service worker và manifest (PWA — ADR 0011): luôn kiểm tra bản mới.
/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache
  Content-Type: application/manifest+json
