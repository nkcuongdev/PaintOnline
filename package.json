{
  "name": "paint-online",
  "private": true,
  "version": "0.0.0",
  "description": "Paint Online — web app vẽ và chú thích ảnh chạy hoàn toàn trong trình duyệt",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit --project dom",
    "test:browser": "vitest run --project browser",
    "test:all": "vitest run",
    "test:watch": "vitest --project unit --project dom",
    "test:e2e": "vite build && playwright test",
    "bench": "vite build --mode bench && playwright test -c playwright.bench.config.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:all && npm run build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --max-warnings=0 --no-warn-ignored --fix",
      "prettier --write"
    ],
    "*.{css,json,md,html,yml,yaml}": "prettier --write"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource/patrick-hand": "5.3.0",
    "@jsquash/webp": "1.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "comlink": "4.4.2",
    "fflate": "0.8.3",
    "idb": "8.0.4",
    "lucide-react": "1.58.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-colorful": "5.8.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "valibot": "1.5.0",
    "workbox-window": "7.4.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "jsdom": "30.1.3",
    "lint-staged": "17.6.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.5"
  }
}
